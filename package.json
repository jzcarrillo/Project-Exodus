{
  "name": "bi-eservices",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run start:dev",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:aws": "docker compose -f docker-compose.aws.yml up --build",
    "deploy:aws": "bash deploy/aws/deploy.sh"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "typescript": "5.9.3"
  },
  "type": "module"
}