# Server Configuration
PORT=4000
NODE_ENV=development

# Database Provider ('dynamodb' or 'sqlite')
DB_PROVIDER=sqlite

# Storage Provider ('s3' or 'local')
STORAGE_PROVIDER=local

# SQLite Configuration (Used when DB_PROVIDER=sqlite)
DATABASE_PATH=data/exodus.db

# AWS Configuration (Used when DB_PROVIDER=dynamodb or STORAGE_PROVIDER=s3)
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key

# DynamoDB Configuration
DYNAMODB_TABLE_PREFIX=BI_
# DYNAMODB_ENDPOINT=http://localhost:8000 # Optional for local DynamoDB

# S3 Configuration
AWS_S3_BUCKET=bi-eservices-documents
# S3_ENDPOINT=http://localhost:4566 # Optional for LocalStack

# Reviewer Email Allowlist
BI_REVIEWER_EMAILS=reviewer@bi.gov.ph,officer@bi.gov.ph
