# AWS
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=<your-access-key>
AWS_SECRET_ACCESS_KEY=<your-secret-key>

# S3
S3_BUCKET=bi-documents

# DynamoDB table names
DYNAMODB_TABLE_APPLICATIONS=bi-applications
DYNAMODB_TABLE_PROFILES=bi-profiles
DYNAMODB_TABLE_DOCUMENTS=bi-documents
DYNAMODB_TABLE_ACTIVITY=bi-activity

# Reviewer allowlist (comma-separated emails)
BI_REVIEWER_EMAILS=reviewer@example.com
